<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarnetDepenses.ViewModels"
             xmlns:models="clr-namespace:CarnetDepenses.Models"
             x:Class="CarnetDepenses.MainPage"
             x:DataType="vm:DepensesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F7F8"
             Title="Carnet de dépenses">

    <ContentPage.Resources>
        <Color x:Key="Encre">#111827</Color>
        <Color x:Key="Gris">#6B7280</Color>
        <Color x:Key="Trait">#ECECEF</Color>
        <Color x:Key="AccentDoux">#EEF2FF</Color>

        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Trait}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        </Style>

        <Style x:Key="Champ" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F9FAFB" />
            <Setter Property="Stroke" Value="{StaticResource Trait}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Encre}" />
            <Setter Property="PlaceholderColor" Value="#9CA3AF" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Padding="20,24" RowSpacing="16"
          MaximumWidthRequest="720">

        <!-- En-tête : total -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border BackgroundColor="{StaticResource AccentDoux}" StrokeThickness="0"
                    WidthRequest="48" HeightRequest="48" VerticalOptions="Start"
                    StrokeShape="RoundRectangle 12">
                <Image Source="icon_wallet.png" WidthRequest="24" HeightRequest="24" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Total des dépenses" FontSize="13" TextColor="{StaticResource Gris}" />
                <Label Text="{Binding Total, StringFormat='{0:N0} FCFA'}"
                       FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Encre}" />
                <Label Text="{Binding Depenses.Count, StringFormat='{0} dépense(s)'}"
                       FontSize="13" TextColor="{StaticResource Gris}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Formulaire d'ajout -->
        <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="10" RowSpacing="10">
                <Border Grid.ColumnSpan="2" Style="{StaticResource Champ}">
                    <Entry Placeholder="Libellé" Text="{Binding Libelle}" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Champ}">
                    <Entry Placeholder="Montant" Keyboard="Numeric"
                           Text="{Binding MontantTexte}" />
                </Border>
                <Button Grid.Row="1" Grid.Column="1" Text="Ajouter"
                        ImageSource="icon_plus.png" ContentLayout="Left,6"
                        Command="{Binding AjouterCommand}"
                        BackgroundColor="{StaticResource Encre}" TextColor="White"
                        FontSize="14" CornerRadius="10"
                        HeightRequest="44" Padding="14,0" />
            </Grid>
        </Border>

        <!-- Conversion via l'API (phase B) -->
        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource AccentDoux}" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36"
                        StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                    <Image Source="icon_convert.png" WidthRequest="18" HeightRequest="18" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Équivalent en euros" FontSize="12" TextColor="{StaticResource Gris}" />
                    <Label Text="{Binding TotalConverti}" FontSize="16"
                           FontAttributes="Bold" TextColor="{StaticResource Encre}" />
                    <Label Text="{Binding Message}" FontSize="12" TextColor="#D97706" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="2" Color="#4F46E5"
                                   WidthRequest="22" HeightRequest="22"
                                   IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="3" Text="Convertir"
                        Command="{Binding ConvertirCommand}"
                        BackgroundColor="Transparent" TextColor="#4F46E5"
                        BorderColor="#C7D2FE" BorderWidth="1"
                        FontSize="14" CornerRadius="10"
                        HeightRequest="38" Padding="14,0" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label Grid.Row="3" Text="HISTORIQUE" FontSize="12" CharacterSpacing="1.5"
               FontAttributes="Bold" TextColor="{StaticResource Gris}" Margin="2,4,0,-6" />

        <!-- Liste des dépenses -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Depenses}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,48" Spacing="10" HorizontalOptions="Center">
                    <Image Source="icon_empty.png" WidthRequest="48" HeightRequest="48" />
                    <Label Text="Aucune dépense pour l'instant"
                           TextColor="{StaticResource Gris}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Depense">
                    <Border Style="{StaticResource Carte}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                            <Border BackgroundColor="{StaticResource AccentDoux}" StrokeThickness="0"
                                    WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                                <Image Source="icon_receipt.png" WidthRequest="20" HeightRequest="20" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Libelle}" FontSize="15"
                                       FontAttributes="Bold" TextColor="{StaticResource Encre}" />
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="12" TextColor="{StaticResource Gris}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2" VerticalOptions="Center"
                                   Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                                   FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Encre}" />

                            <!-- Dans un DataTemplate, le BindingContext est la Depense :
                                 RelativeSource remonte jusqu'au ViewModel. -->
                            <ImageButton Grid.Column="3" Source="icon_trash.png"
                                         WidthRequest="36" HeightRequest="36" Padding="9"
                                         CornerRadius="18" BackgroundColor="Transparent"
                                         VerticalOptions="Center"
                                         CommandParameter="{Binding .}"
                                         Command="{Binding Source={RelativeSource
                                             AncestorType={x:Type vm:DepensesViewModel}},
                                             Path=SupprimerCommand}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
