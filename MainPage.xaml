<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarnetDepenses.ViewModels"
             xmlns:models="clr-namespace:CarnetDepenses.Models"
             x:Class="CarnetDepenses.MainPage"
             x:DataType="vm:DepensesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F7F7F8, Dark=#0B0B0F}"
             Title="Carnet de dépenses">

    <ContentPage.Resources>
        <Color x:Key="Encre">#111827</Color>
        <Color x:Key="Gris">#6B7280</Color>
        <Color x:Key="Trait">#ECECEF</Color>
        <Color x:Key="AccentDoux">#EEF2FF</Color>
        <!-- Mode sombre : suit automatiquement le thème du téléphone -->
        <Color x:Key="EncreSombre">#F3F4F6</Color>
        <Color x:Key="GrisSombre">#9CA3AF</Color>
        <Color x:Key="TraitSombre">#26262F</Color>
        <Color x:Key="AccentDouxSombre">#23234A</Color>

        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#16161D}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Trait}, Dark={StaticResource TraitSombre}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        </Style>

        <Style x:Key="Champ" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F9FAFB, Dark=#1E1E27}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Trait}, Dark={StaticResource TraitSombre}}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Encre}, Dark={StaticResource EncreSombre}}" />
            <Setter Property="PlaceholderColor" Value="#9CA3AF" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Padding="20,24" RowSpacing="16"
          MaximumWidthRequest="720">

        <!-- En-tête : total -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentDoux}, Dark={StaticResource AccentDouxSombre}}" StrokeThickness="0"
                    WidthRequest="48" HeightRequest="48" VerticalOptions="Start"
                    StrokeShape="RoundRectangle 12">
                <Image Source="icon_wallet.png" WidthRequest="24" HeightRequest="24" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Total des dépenses" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gris}, Dark={StaticResource GrisSombre}}" />
                <Label Text="{Binding Total, StringFormat='{0:N0} FCFA'}"
                       FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Encre}, Dark={StaticResource EncreSombre}}" />
                <Label Text="{Binding Depenses.Count, StringFormat='{0} dépense(s)'}"
                       FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gris}, Dark={StaticResource GrisSombre}}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Formulaire d'ajout -->
        <Border Grid.Row="1" Style="{StaticResource Carte}" Padding="12">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="10" RowSpacing="10">
                <Border Grid.ColumnSpan="2" Style="{StaticResource Champ}">
                    <Entry Placeholder="Libellé" Text="{Binding Libelle}" />
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Champ}">
                    <Entry Placeholder="Montant" Keyboard="Numeric"
                           Text="{Binding MontantTexte}" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Champ}">
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding CategorieChoisie}"
                            TextColor="{AppThemeBinding Light={StaticResource Encre}, Dark={StaticResource EncreSombre}}"
                            BackgroundColor="Transparent" FontSize="15"
                            VerticalOptions="Center" />
                </Border>
                <Button Grid.Row="2" Grid.ColumnSpan="2" Text="Ajouter la dépense"
                        ImageSource="icon_plus.png" ContentLayout="Left,6"
                        Command="{Binding AjouterCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Encre}, Dark=#4F46E5}" TextColor="White"
                        FontSize="14" CornerRadius="10" HeightRequest="44" />
            </Grid>
        </Border>

        <!-- Conversion via l'API (phase B) -->
        <Border Grid.Row="2" Style="{StaticResource Carte}" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentDoux}, Dark={StaticResource AccentDouxSombre}}" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36"
                        StrokeShape="RoundRectangle 18" VerticalOptions="Center">
                    <Image Source="icon_convert.png" WidthRequest="18" HeightRequest="18" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Équivalent en euros" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gris}, Dark={StaticResource GrisSombre}}" />
                    <Label Text="{Binding TotalConverti}" FontSize="16"
                           FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Encre}, Dark={StaticResource EncreSombre}}" />
                    <Label Text="{Binding Message}" FontSize="12" TextColor="#D97706" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="2" Color="#4F46E5"
                                   WidthRequest="22" HeightRequest="22"
                                   IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="3" Text="Convertir"
                        Command="{Binding ConvertirCommand}"
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#4F46E5, Dark=#A5B4FC}"
                        BorderColor="{AppThemeBinding Light=#C7D2FE, Dark=#3730A3}" BorderWidth="1"
                        FontSize="14" CornerRadius="10"
                        HeightRequest="38" Padding="14,0" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Historique + recherche -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,0,0,-6">
            <Label Text="HISTORIQUE" FontSize="12" CharacterSpacing="1.5"
                   FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gris}, Dark={StaticResource GrisSombre}}"
                   VerticalOptions="Center" />
            <Border Grid.Column="1" Style="{StaticResource Champ}" BackgroundColor="{AppThemeBinding Light=White, Dark=#16161D}"
                    HeightRequest="38" WidthRequest="190">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <Image Source="icon_search.png" WidthRequest="18" HeightRequest="18" />
                    <Entry Grid.Column="1" Placeholder="Rechercher" FontSize="14"
                           Text="{Binding Filtre}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Liste des dépenses -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Affichees}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,48" Spacing="10" HorizontalOptions="Center">
                    <Image Source="icon_empty.png" WidthRequest="48" HeightRequest="48" />
                    <Label Text="Aucune dépense pour l'instant"
                           TextColor="{AppThemeBinding Light={StaticResource Gris}, Dark={StaticResource GrisSombre}}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Depense">
                    <Border Style="{StaticResource Carte}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentDoux}, Dark={StaticResource AccentDouxSombre}}" StrokeThickness="0"
                                    WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                                <Image Source="{Binding Icone}" WidthRequest="20" HeightRequest="20" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Libelle}" FontSize="15"
                                       FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Encre}, Dark={StaticResource EncreSombre}}" />
                                <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gris}, Dark={StaticResource GrisSombre}}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} · {1:dd/MM/yyyy}">
                                            <Binding Path="Categorie" />
                                            <Binding Path="Date" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>

                            <Label Grid.Column="2" VerticalOptions="Center"
                                   Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                                   FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Encre}, Dark={StaticResource EncreSombre}}" />

                            <!-- Dans un DataTemplate, le BindingContext est la Depense :
                                 RelativeSource remonte jusqu'au ViewModel. -->
                            <ImageButton Grid.Column="3" Source="icon_trash.png"
                                         WidthRequest="36" HeightRequest="36" Padding="9"
                                         CornerRadius="18" BackgroundColor="Transparent"
                                         VerticalOptions="Center"
                                         CommandParameter="{Binding .}"
                                         Command="{Binding Source={RelativeSource
                                             AncestorType={x:Type vm:DepensesViewModel}},
                                             Path=SupprimerCommand}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
